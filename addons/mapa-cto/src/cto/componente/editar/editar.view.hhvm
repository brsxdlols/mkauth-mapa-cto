            box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
        }

        .clients-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
        }

        .client-list {
            border: 2px solid #e5e7eb;
