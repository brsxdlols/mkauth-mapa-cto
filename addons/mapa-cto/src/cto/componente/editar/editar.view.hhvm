        }

        .client-items-container {
            flex: 1;
            overflow-y: auto;
            padding-right: 5px;
        }

        .client-items-container::-webkit-scrollbar {
            width: 6px;
        }

        .client-items-container::-webkit-scrollbar-track {
            background: #f1f1f1;
