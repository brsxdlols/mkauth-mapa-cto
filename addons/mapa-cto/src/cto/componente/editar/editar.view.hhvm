        }


        .cto-map-info-grid {
            display: grid;
            grid-template-columns: minmax(190px, 34%) minmax(0, 1fr);
            gap: 10px;
            align-items: start;
            margin-bottom: 8px;
        }

        .cto-map-col .form-group,
        .cto-info-col .form-group {
            margin-bottom: 8px;
        }

        .cto-info-col textarea {
            min-height: 54px;
        }

        .usage-card-right {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 10px 12px;
            border-radius: 10px;
            margin: 10px 0 12px;
            color: white;
            box-shadow: 0 6px 16px rgba(102, 126, 234, 0.16);
        }

        .usage-card-right .usage-title {
            text-transform: uppercase;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .usage-card-right .usage-metrics {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 8px;
            text-align: center;
            margin-bottom: 8px;
        }

        .usage-card-right .usage-number {
            display: block;
            font-size: 22px;
            line-height: 1;
            font-weight: 800;
        }

        .usage-card-right .usage-label {
            display: block;
            font-size: 11px;
            opacity: 0.92;
            margin-top: 3px;
        }

        .usage-card-right .usage-bar {
            height: 8px;
            background: rgba(255,255,255,0.28);
            border-radius: 999px;
            overflow: hidden;
        }

        .usage-card-right .usage-bar span {
            display: block;
            height: 100%;
            background: linear-gradient(90deg, #10b981, #f59e0b);
            border-radius: inherit;
        }

        @media (max-width: 1200px) {
            .cto-map-info-grid { grid-template-columns: 1fr; }
        }

        .port-modal-overlay {
            position: fixed;
            inset: 0;
            z-index: 2500;
            background: rgba(15, 23, 42, 0.55);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 18px;
        }

        .port-modal {
            width: min(760px, 96vw);
            max-height: 92vh;
            overflow: auto;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.30);
        }

        .port-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 16px 18px;
            color: #fff;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .port-modal-header h3 {
            margin: 0;
            color: #fff;
            font-size: 18px;
            border: 0;
            padding: 0;
        }

        .port-modal-close {
            border: 0;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.18);
            color: #fff;
            font-size: 20px;
            width: 34px;
            height: 34px;
            cursor: pointer;
        }

        .port-modal-body {
            padding: 18px;
        }

        .port-client-summary {
            background: #f8fafc;
            border: 1px solid #dbe4f0;
            border-radius: 10px;
            padding: 12px;
            margin-bottom: 14px;
            color: #1f2937;
            line-height: 1.6;
        }

        .port-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
            gap: 10px;
            margin-top: 10px;
        }

        .port-btn {
            border: 1px solid #bfdbfe;
            background: #eff6ff;
            color: #2563eb;
            border-radius: 8px;
            min-height: 54px;
            padding: 8px 6px;
            font-weight: 700;
            cursor: pointer;
            line-height: 1.2;
        }

        .port-btn small {
            display: block;
            font-size: 11px;
            font-weight: 600;
            margin-top: 3px;
        }

        .port-btn.is-busy {
            border-color: #fecaca;
            background: #fee2e2;
            color: #dc2626;
            cursor: not-allowed;
        }

        .port-modal-footer {
            padding: 0 18px 18px;
        }

        .port-cancel {
            width: 100%;
            border: 0;
            border-radius: 8px;
            background: #e5e7eb;
            color: #111827;
            padding: 12px;
            font-weight: 700;
            cursor: pointer;
        }

        @media (max-width: 1200px) {
            .content-wrapper {
