<!-- codex-address-autocomplete-v3-start -->
<script>
(function () {
    var endereco = document.getElementById('ENDERECO');
    var lat = document.getElementById('LATITUDE');
    var lng = document.getElementById('LONGITUDE');
    var mini = document.getElementById('miniMapaCto');
    if (!endereco || !lat || !lng) return;

    var parent = endereco.closest ? endereco.closest('.form-group') : endereco.parentNode;
    if (!parent) return;
    parent.style.position = 'relative';

    var suggestions = parent.querySelector('.address-suggestions');
    if (!suggestions) {
        suggestions = document.createElement('div');
        suggestions.className = 'address-suggestions';
        parent.appendChild(suggestions);
    }

    var status = parent.querySelector('.address-status');
    if (!status) {
        status = document.createElement('div');
        status.className = 'address-status';
        status.textContent = 'Digite endereco, numero, bairro ou CEP para buscar automaticamente.';
        parent.appendChild(status);
    }

    var timer = null;
    var seq = 0;

    function normalizeCoord(value) {
        return String(value || '').trim().replace(',', '.');
    }

    function validCoord(value) {
        return /^-?\d+(\.\d+)?$/.test(normalizeCoord(value));
    }

    function setStatus(text) {
        status.textContent = text || '';
    }

    function numberFromText(text) {
        var match = String(text || '').match(/\b(\d{1,6})\b/);
        return match ? match[1] : '';
    }

    function miniMapUrl(la, lo) {
        la = parseFloat(normalizeCoord(la));
        lo = parseFloat(normalizeCoord(lo));
        var d = 0.0045;
        var bbox = (lo - d) + ',' + (la - d) + ',' + (lo + d) + ',' + (la + d);
        return 'https://www.openstreetmap.org/export/embed.html?bbox=' + encodeURIComponent(bbox) + '&layer=mapnik&marker=' + encodeURIComponent(la + ',' + lo);
    }

    function updateMiniMap(la, lo) {
        if (!mini || !validCoord(la) || !validCoord(lo)) return;
        var iframe = mini.querySelector('iframe');
        if (!iframe) {
            mini.innerHTML = '';
            iframe = document.createElement('iframe');
            iframe.loading = 'lazy';
            iframe.title = 'Localizacao da CTO';
            mini.appendChild(iframe);
        }
        iframe.src = miniMapUrl(la, lo);
    }

    function hideSuggestions() {
        suggestions.style.display = 'none';
        suggestions.innerHTML = '';
    }

    function applyResult(item) {
        var label = item.display_name || item.label || '';
        endereco.value = label;
        lat.value = String(item.lat || '').replace('.', ',');
        lng.value = String(item.lon || '').replace('.', ',');
        updateMiniMap(item.lat, item.lon);
        hideSuggestions();
        setStatus('Endereco localizado. Confira o marcador no mini mapa.');
    }

    function render(items) {
        suggestions.innerHTML = '';
        if (!items || !items.length) {
            hideSuggestions();
            setStatus('Nenhum endereco encontrado para essa busca.');
            return;
        }

        items.slice(0, 6).forEach(function (item) {
            var div = document.createElement('div');
            div.className = 'address-suggestion-item';
            var title = document.createElement('div');
            title.className = 'address-suggestion-title';
            title.textContent = item.display_name || item.label || 'Endereco encontrado';
            div.appendChild(title);
            if (item.type || item.class) {
                var small = document.createElement('div');
                small.textContent = [item.class, item.type].filter(Boolean).join(' / ');
                div.appendChild(small);
            }
            div.addEventListener('click', function () { applyResult(item); });
            suggestions.appendChild(div);
        });
        suggestions.style.display = 'block';
        setStatus('Escolha uma opcao para preencher latitude e longitude.');
    }

    function buildViaCepQuery(raw, data) {
        var parts = [];
        var number = numberFromText(raw);
        if (data.logradouro) parts.push(data.logradouro);
        if (number) parts.push(number);
        if (data.bairro) parts.push(data.bairro);
        if (data.localidade) parts.push(data.localidade);
        if (data.uf) parts.push(data.uf);
        return parts.join(', ') || raw;
    }

    function fetchJson(url) {
        return fetch(url, { credentials: 'omit' }).then(function (resp) {
            if (!resp.ok) throw new Error('HTTP ' + resp.status);
            return resp.json();
        });
    }

    function queryViaCepIfNeeded(raw) {
        var match = raw.match(/\b(\d{5})-?(\d{3})\b/);
        if (!match) return Promise.resolve(raw);
        var cep = match[1] + match[2];
        return fetchJson('https://viacep.com.br/ws/' + cep + '/json/')
            .then(function (data) {
                if (!data || data.erro) return raw;
                return buildViaCepQuery(raw, data);
            })
            .catch(function () { return raw; });
    }

    function searchAddress(raw) {
        var ticket = ++seq;
        queryViaCepIfNeeded(raw).then(function (query) {
            if (ticket !== seq) return;
            var url = 'https://nominatim.openstreetmap.org/search?format=json&limit=6&addressdetails=1&countrycodes=br&q=' + encodeURIComponent(query);
            return fetchJson(url);
        }).then(function (items) {
            if (ticket !== seq || !items) return;
            render(items);
        }).catch(function () {
            if (ticket !== seq) return;
            hideSuggestions();
            setStatus('Nao foi possivel buscar agora. Verifique a conexao e tente novamente.');
        });
    }

    endereco.addEventListener('input', function () {
        var raw = endereco.value.trim();
        clearTimeout(timer);
        if (raw.length < 4) {
            hideSuggestions();
            setStatus('Digite endereco, numero, bairro ou CEP para buscar automaticamente.');
            return;
        }
        setStatus('Buscando endereco...');
        timer = setTimeout(function () { searchAddress(raw); }, 550);
    });

    lat.addEventListener('change', function () { updateMiniMap(lat.value, lng.value); });
    lng.addEventListener('change', function () { updateMiniMap(lat.value, lng.value); });

    document.addEventListener('click', function (event) {
        if (parent && !parent.contains(event.target)) hideSuggestions();
    });
})();
</script>
<!-- codex-address-autocomplete-v3-end -->
