    <script>
    (function () {
        var tipo = document.getElementById('TIPO');
        var oltLabel = document.getElementById('OLT_LABEL');
        var fspLabel = document.getElementById('FSP_LABEL');
        var olt = document.getElementById('OLT');
        var fsp = document.getElementById('FSP');

        function atualizarCamposRadio() {
            var valor = tipo ? tipo.value : '';
            if (valor === 'AP' || valor === 'STA' || valor === 'TO') {
                oltLabel.innerHTML = 'Painel/Equipamento:';
                olt.placeholder = 'Ex: Painel setorial, Rocket, LiteBeam';
                if (valor === 'STA') {
                    fspLabel.innerHTML = 'AP vinculado:';
                    fsp.placeholder = 'Selecione ou digite o AP';
                    fsp.setAttribute('list', 'AP_OPTIONS');
                } else if (valor === 'AP') {
                    fspLabel.innerHTML = 'Canal/Setor:';
                    fsp.placeholder = 'Ex: Setor 1 / 5.8GHz';
                    fsp.removeAttribute('list');
                } else {
                    fspLabel.innerHTML = 'Estrutura/Setor:';
                    fsp.placeholder = 'Ex: Torre principal / setor norte';
                    fsp.removeAttribute('list');
                }
            } else {
                oltLabel.innerHTML = 'OLT:';
                olt.placeholder = 'Ex: OLT - ZTE';
                fspLabel.innerHTML = 'FSP:';
                fsp.placeholder = '';
                fsp.removeAttribute('list');
            }
        }

        if (tipo) {
            tipo.addEventListener('change', atualizarCamposRadio);
            atualizarCamposRadio();
        }
    })();
    </script>

