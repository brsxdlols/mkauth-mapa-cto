<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Listar CTOs</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f7fb;
            padding: 32px;
            color: #111827;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .header {
            background: white;
            padding: 24px;
            border-radius: 8px;
            border: 1px solid #e5e7eb;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
            margin-bottom: 16px;
        }

        .header h2 {
            color: #111827;
            font-size: 26px;
            margin-bottom: 8px;
        }

        .header p {
            color: #64748b;
            font-size: 14px;
        }

        .header-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 14px;
        }

        .top-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .top-link {
            display: inline-block;
            padding: 10px 14px;
            border-radius: 6px;
            color: #fff;
            text-decoration: none;
            font-weight: 700;
            font-size: 13px;
            white-space: nowrap;
        }

        .top-link.map {
            background: #059669;
        }

        .top-link.panel {
            background: #4f46e5;
        }

        .filters {
            background: white;
            padding: 14px;
            border-radius: 8px;
            border: 1px solid #e5e7eb;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
            margin-bottom: 16px;
        }

        .filter-group {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 12px;
            margin-bottom: 12px;
        }

        .filter-item {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .filter-item label {
            font-weight: 600;
            color: #475569;
            font-size: 12px;
        }

        .filter-item input,
        .filter-item select {
            padding: 10px;
            border: 1px solid #dbe2ea;
            border-radius: 6px;
            font-size: 14px;
            font-family: inherit;
        }

        .filter-item input:focus,
        .filter-item select:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.10);
        }

        .buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-primary {
            background: #4f46e5;
            color: white;
        }

        .btn-primary:hover {
            background: #4338ca;
        }

        .table-wrapper {
            background: white;
            border-radius: 8px;
            border: 1px solid #e5e7eb;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
            overflow-x: auto;
        }

        table {
            width: 100%;
            min-width: 900px;
            border-collapse: collapse;
        }

        table thead {
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
        }

        table th {
            padding: 12px;
            text-align: left;
            font-weight: 600;
            color: #334155;
            font-size: 13px;
        }

        table td {
            padding: 10px 12px;
            border-bottom: 1px solid #e5e7eb;
            font-size: 13px;
            color: #334155;
        }

        table tbody tr:hover {
            background-color: #f8fafc;
        }

        table tbody tr:nth-child(even) {
            background-color: transparent;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-active {
            background-color: #d4edda;
            color: #155724;
        }

        .status-inactive {
            background-color: #f8d7da;
            color: #721c24;
        }

        .action-buttons {
            display: flex;
            gap: 8px;
        }

        .btn-small {
            padding: 7px 10px;
            font-size: 12px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 700;
        }

        .btn-edit {
            background: #0ea5e9;
            color: white;
        }

        .btn-edit:hover {
            background: #0284c7;
        }

        .btn-delete {
            background: #ef4444;
            color: white;
        }

        .btn-delete:hover {
            background: #dc2626;
        }

        .btn-map {
            background: #10b981;
            color: white;
        }

        .btn-map:hover {
            background: #059669;
        }

        .client-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 34px;
            padding: 4px 10px;
            border-radius: 999px;
            background: #eef2ff;
            color: #4f46e5;
            font-weight: 700;
        }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: #999;
        }

        .empty-state p {
            font-size: 16px;
            margin-bottom: 10px;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
            margin-bottom: 16px;
        }

        .stat-card {
            background: white;
            padding: 14px 16px;
            border-radius: 8px;
            border: 1px solid #e5e7eb;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
            text-align: left;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .stat-card .number {
            font-size: 26px;
            font-weight: bold;
            color: #4f46e5;
            margin: 0;
        }

        .stat-card .label {
            font-size: 13px;
            color: #64748b;
        }

        .loading {
            text-align: center;
            padding: 40px;
            color: #999;
        }
        .header { border-radius: 16px; }
        .header-row { align-items: center; }
        .filters { padding: 20px; border-radius: 12px; }
        .table-wrapper { border-radius: 12px; }
        .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
        .stat-card { padding: 20px; border-radius: 12px; flex-direction: column; align-items: flex-start; gap: 12px; }
        .stat-card .number { color: #24334d; font-size: 30px; }
        .top-link, .btn, .btn-small { font-family: inherit; }
        .action-buttons { flex-wrap: nowrap; }
        .btn-small { white-space: nowrap; }
        .btn-edit { background: #eef2ff; color: #4338ca; }
        .btn-edit:hover { background: #e0e7ff; }
        .btn-delete { background: #fff1f2; color: #be123c; }
        .btn-delete:hover { background: #ffe4e6; }
        a:focus-visible, button:focus-visible { outline: 3px solid #818cf8; outline-offset: 3px; }
        @media (max-width: 900px) { .header-row { flex-direction: column; align-items: stretch; } .top-actions { justify-content: flex-start; } .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        @media (max-width: 600px) { body { padding: 16px; } .header { padding: 20px; } .header h2 { font-size: 23px; } .filter-group { grid-template-columns: 1fr; } .stats { gap: 10px; } .stat-card { padding: 16px; } .filters { padding: 16px; } }
    </style>
</head>
<body>

<div class="container">
    <!-- Header -->
    <div class="header">
        <div class="header-row">
            <div>
                <h2>Listar CTOs</h2>
                <p><?php echo isset($textoSubTitulo) ? $textoSubTitulo : 'Gerenciamento de CTOs da rede de fibra óptica'; ?></p>
            </div>
            <div class="top-actions">
                <a href="?_route=mapadectos" class="top-link map">Mapa de CTOs</a>
                <a href="?_route=painel" class="top-link panel">Painel Principal</a>
            </div>
        </div>
    </div>

    <!-- Stats -->
    <div class="stats">
        <div class="stat-card">
            <div class="label">CTOs Cadastradas</div>
            <div class="number"><?php echo isset($numeroCaixas) ? $numeroCaixas : '0'; ?></div>
        </div>
        <div class="stat-card">
            <div class="label">Portas Totais</div>
            <div class="number"><?php echo isset($numeroPortas) ? $numeroPortas : '0'; ?></div>
        </div>
        <div class="stat-card">
            <div class="label">Portas Livres</div>
            <div class="number"><?php echo isset($numeroPortasLivres) ? $numeroPortasLivres : '0'; ?></div>
        </div>
        <div class="stat-card">
            <div class="label">Portas Ativas</div>
            <div class="number"><?php echo isset($numeroPortasAtivas) ? $numeroPortasAtivas : '0'; ?></div>
        </div>
    </div>

    <!-- Filters -->
    <div class="filters">
        <div class="filter-group">
            <div class="filter-item">
                <label for="buscarModelo">Buscar</label>
                <input 
                    type="text" 
                    id="buscarModelo" 
                    placeholder="Digite o nome ou ID da CTO"
                    onkeyup="filtrarTabela()"
                >
            </div>
            <div class="filter-item">
                <label for="buscarBairro">Bairro</label>
                <input 
                    type="text" 
                    id="buscarBairro" 
                    placeholder="Digite o bairro"
                    onkeyup="filtrarTabela()"
                >
            </div>
            <div class="filter-item">
                <label for="buscarCidade">Cidade</label>
                <input 
                    type="text" 
                    id="buscarCidade" 
                    placeholder="Digite a cidade"
                    onkeyup="filtrarTabela()"
                >
            </div>
            <div class="filter-item">
                <label for="buscarFiltro">Filtro</label>
                <select id="buscarFiltro" onchange="filtrarTabela()">
                    <option value="">Todas as caixas</option>
                    <option value="ativa">Ativas</option>
                    <option value="inativa">Inativas</option>
                </select>
            </div>
        </div>

        <div class="buttons">
            <button class="btn btn-primary" onclick="adicionarCTO()">
                Adicionar CTO
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="table-wrapper">
        <?php if (isset($resultado) && $resultado && mysqli_num_rows($resultado) > 0): ?>
            <table>
                <thead>
                    <tr>
                        <th width="5%">ID</th>
                        <th width="15%">Nome</th>
                        <th width="20%">Endereço</th>
                        <th width="10%">Tipo</th>
                        <th width="8%">Cap.</th>
                        <th width="9%">Clientes</th>
                        <th width="8%">Sinal</th>
                        <th width="12%">OLT</th>
                        <th width="21%">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <?php 
                    while ($row = mysqli_fetch_assoc($resultado)): 
                        $sinal = intval($row['sinal'] ?? 0);
                        $statusClass = ($sinal >= 0) ? 'status-active' : 'status-inactive';
                        $statusText = ($sinal >= 0) ? 'Bom' : 'Fraco';
                    ?>
                        <tr>
                            <td><strong><?php echo $row['id']; ?></strong></td>
                            <td><?php echo htmlspecialchars($row['nome'] ?? ''); ?></td>
                            <td><?php echo htmlspecialchars($row['endereco'] ?? ''); ?></td>
                            <td><?php echo htmlspecialchars($row['tipo'] ?? ''); ?></td>
                            <td><?php echo htmlspecialchars($row['capacidade'] ?? '0'); ?> portas</td>
                            <td><span class="client-count"><?php echo (int)($clientesPorCaixa[$row['id']] ?? 0); ?></span></td>
                            <td><strong><?php echo $row['sinal'] ?? '0'; ?> dB</strong></td>
                            <td><?php echo htmlspecialchars($row['olt'] ?? ''); ?></td>
                            <td>
                                <div class="action-buttons">
                                    <button class="btn-small btn-edit" onclick="editarCTO(<?php echo $row['id']; ?>)">
                                        ✏️ Editar
                                    </button>
                                    <button class="btn-small btn-delete" onclick="excluirCTO(<?php echo $row['id']; ?>)">
                                        🗑️ Deletar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <?php endwhile; ?>
                </tbody>
            </table>
        <?php else: ?>
            <div class="empty-state">
                <p>📭 Nenhuma CTO cadastrada ainda</p>
                <p>Clique em "Adicionar CTO" para começar</p>
            </div>
        <?php endif; ?>
    </div>
</div>

<script>
function filtrarTabela() {
    const busca = document.getElementById('buscarModelo').value.toLowerCase();
    const bairro = document.getElementById('buscarBairro').value.toLowerCase();
    const cidade = document.getElementById('buscarCidade').value.toLowerCase();
    const filtro = document.getElementById('buscarFiltro').value;
    const tabela = document.querySelector('table tbody');
    
    if (!tabela) return;
    
    const linhas = tabela.querySelectorAll('tr');
    linhas.forEach(linha => {
        const texto = linha.textContent.toLowerCase();
        const enderecoColuna = linha.cells[2]?.textContent.toLowerCase() || '';
        const status = linha.querySelector('.status-badge')?.textContent.toLowerCase() || '';
        let mostrar = true;
        
        if (busca && !texto.includes(busca)) {
            mostrar = false;
        }
        
        if (bairro && !enderecoColuna.includes(bairro)) {
            mostrar = false;
        }
        
        if (cidade && !enderecoColuna.includes(cidade)) {
            mostrar = false;
        }
        
        if (filtro === 'ativa' && !status.includes('ativa')) {
            mostrar = false;
        } else if (filtro === 'inativa' && !status.includes('inativa')) {
            mostrar = false;
        }
        
        linha.style.display = mostrar ? '' : 'none';
    });
}

function adicionarCTO() {
    window.location.href = '?_route=adicionar';
}

function editarCTO(id) {
    window.location.href = '?_route=editar&id=' + id;
}

function excluirCTO(id) {
    if (confirm('Tem certeza que deseja deletar esta CTO?')) {
        // Enviar requisição POST para deletar
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '?_route=inicio';
        
        const inputId = document.createElement('input');
        inputId.type = 'hidden';
        inputId.name = 'id_deletar';
        inputId.value = id;
        
        form.appendChild(inputId);
        document.body.appendChild(form);
        form.submit();
    }
}
</script>

</body>
</html>
